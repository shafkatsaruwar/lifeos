+/**
+ * LifeOS: render stored PKDrawing base64 → PNG base64 (no live canvas required).
+ */
+export async function renderDrawingPng(base64String, width, height, scale = 2) {
+    if (Platform.OS !== "ios" || !ExpoPencilKit || !base64String) {
+        return "";
+    }
+    return (await ExpoPencilKit.renderDrawingPng(base64String, width, height, scale)) || "";
+}
+/**
+ * LifeOS: render one PDF page to PNG base64 via native PDFKit.
+ */
+export async function renderPdfPagePng(filePath, pageIndex, scale = 2) {
+    if (Platform.OS !== "ios" || !ExpoPencilKit || !filePath) {
+        return "";
+    }
+    return (await ExpoPencilKit.renderPdfPagePng(filePath, pageIndex, scale)) || "";
+}
