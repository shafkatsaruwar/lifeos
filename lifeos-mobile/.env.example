# Production LifeOS URL (optional)
EXPO_PUBLIC_LIFEOS_URL=https://lifeos-mu-three.vercel.app

# Optional: only needed if you switch back to direct Expo Google OAuth
# (Google currently blocks Expo Go exp:// redirects, so the shell uses
# https://lifeos…/shell-auth instead).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
