# Production LifeOS URL (used for Google OAuth bridge + AI/iCal APIs)
EXPO_PUBLIC_LIFEOS_URL=https://lifeos-mu-three.vercel.app

# EAS Update (OTA). Same UUID as Expo dashboard → Project settings.
# Also add as GitHub Actions secrets: EAS_PROJECT_ID + EXPO_TOKEN.
# EAS_PROJECT_ID=
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Firebase (optional — defaults match production LifeOS web client config)
# EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAbMSSRscUp7CMbeCYuOp5SC6utZ3QPNNM
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=lifeos-45586.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://lifeos-45586-default-rtdb.firebaseio.com/
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=lifeos-45586


# Web client ID is passed to /shell-auth for Google OAuth in Expo Go.
# In Google Cloud → Credentials → that Web client, add Authorized redirect URI:
#   https://lifeos-mu-three.vercel.app/shell-auth
# and Authorized JavaScript origin:
#   https://lifeos-mu-three.vercel.app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional (for future standalone builds)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
