# Production LifeOS URL (optional)
EXPO_PUBLIC_LIFEOS_URL=https://lifeos-mu-three.vercel.app

# Web client ID is passed to /shell-auth for direct Google OAuth (recommended).
# In Google Cloud → Credentials → that Web client, add Authorized redirect URI:
#   https://lifeos-mu-three.vercel.app/shell-auth
# and Authorized JavaScript origin:
#   https://lifeos-mu-three.vercel.app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional:
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
