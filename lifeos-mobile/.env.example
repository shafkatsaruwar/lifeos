# Copy to lifeos-mobile/.env

# Your LifeOS web app origin (local or deployed)
EXPO_PUBLIC_LIFEOS_URL=http://localhost:3000

# EAS Update — replace after `eas init`
# EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
# EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# Firebase (required for cloud sign-in / sync — same project as the web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project

# Optional Google web client for faster /shell-auth OAuth
# Add Authorized redirect URI: https://YOUR_HOST/shell-auth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
