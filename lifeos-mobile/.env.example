# Production LifeOS URL (optional)
EXPO_PUBLIC_LIFEOS_URL=https://lifeos-mu-three.vercel.app

# Required for Google sign-in inside the iPhone WebView shell.
# Use the same Google Cloud project as web LifeOS.
# Create an iOS OAuth client (bundle: com.shafkatsaruwar.lifeos)
# and a Web OAuth client, then paste both IDs here.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional until Android phase:
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
