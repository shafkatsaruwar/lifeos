{
  "name": "lifeos-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "update:preview": "eas update --channel preview --message \"preview $(date -u +%Y-%m-%dT%H:%MZ)\" --non-interactive",
    "update:production": "eas update --channel production --message \"production $(date -u +%Y-%m-%dT%H:%MZ)\" --non-interactive",
    "postinstall": "patch-package && node ./scripts/ensure-expo-installed.js"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "babel-preset-expo": "~54.0.10",
    "cliui": "^8.0.1",
    "commander": "^7.2.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-live-activity": "^0.4.2",
    "expo-notifications": "~0.32.17",
    "expo-pencilkit-ui": "^1.0.4",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.17.1",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "patch-package": "^8.0.1",
    "sucrase": "^3.35.0",
    "ts-interface-checker": "^1.0.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "expo-font": "~14.0.12"
  }
}
