# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_DB_URL=
NEXT_PUBLIC_LIFEOS_AUTH_DOMAIN=
# Optional: same Web client ID as lifeos-mobile. Used by /shell-auth direct Google OAuth.
# Also add Authorized redirect URI: https://lifeos-mu-three.vercel.app/shell-auth
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gmail OAuth
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Outlook OAuth
MICROSOFT_OUTLOOK_CLIENT_ID=
MICROSOFT_OUTLOOK_CLIENT_SECRET=
MICROSOFT_OUTLOOK_TENANT_ID=common

# iCloud calendar token encryption
ICLOUD_CONNECTION_SECRET=

# LifeOS MCP (stdio + optional HTTP /api/mcp)
# Stdio runs as the local user — no token required.
# HTTP is disabled until LIFEOS_MCP_TOKEN is set (503 otherwise).
# Live Firebase wins over a leftover ~/.lifeos/export.json unless LIFEOS_DATA_PATH is set.
# See MCP.md and Settings → Assistant access. Do not commit secrets.
LIFEOS_MCP_TOKEN=
LIFEOS_DATA_PATH=
LIFEOS_USER_ID=
LIFEOS_FIREBASE_DB_URL=
LIFEOS_FIREBASE_AUTH=
LIFEOS_FIREBASE_API_KEY=
LIFEOS_FIREBASE_EMAIL=
LIFEOS_FIREBASE_PASSWORD=
LIFEOS_FIREBASE_REFRESH_TOKEN=
# Optional admin REST (reads users/{LIFEOS_USER_ID} only). JSON string or file path.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
