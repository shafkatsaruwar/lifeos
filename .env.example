# Copy to .env.local and fill in YOUR Firebase / OAuth project values.
# Leave Firebase blank to run the web app local-only (Dev: Test Login on localhost).

# Firebase (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com/
# Optional: custom domain used for Google OAuth (/__/auth rewrite)
NEXT_PUBLIC_LIFEOS_AUTH_DOMAIN=

# Google OAuth (web client) — add Authorized redirect URI: https://YOUR_HOST/shell-auth
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public site URL (unsubscribe links, marketing footers)
NEXT_PUBLIC_LIFEOS_SITE_URL=http://localhost:3000

# Legal / CAN-SPAM / DMCA (replace with your real entity before production)
LIFEOS_LEGAL_ENTITY_NAME=LifeOS
LIFEOS_LEGAL_PHYSICAL_ADDRESS=
LIFEOS_SUPPORT_EMAIL=support@example.com
LIFEOS_DMCA_AGENT_NAME=DMCA Designated Agent
LIFEOS_DMCA_AGENT_TITLE=Copyright Agent
LIFEOS_DMCA_AGENT_EMAIL=dmca@example.com
LIFEOS_DMCA_AGENT_PHONE=
LIFEOS_DMCA_AGENT_ADDRESS=

# Anthropic (optional — AI features)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gmail OAuth (optional)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Outlook OAuth (optional)
MICROSOFT_OUTLOOK_CLIENT_ID=
MICROSOFT_OUTLOOK_CLIENT_SECRET=
MICROSOFT_OUTLOOK_TENANT_ID=common

# iCloud calendar token encryption (optional)
ICLOUD_CONNECTION_SECRET=
